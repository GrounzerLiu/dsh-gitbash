{
  "name": "dsh-gitbash",
  "version": "0.2.1",
  "description": "DSH profile plugin: run the model-facing bash tool on Git for Windows (Git Bash). NOT file-sandboxed — the msys2 runtime cannot run under the Windows restricted-token sandbox, so commands run with the harness process's full file access (see README).",
  "type": "module",
  "main": "lib/executor.js",
  "exports": {
    ".": "./lib/executor.js",
    "./tool": "./lib/tool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-shell": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-shell": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  }
}
