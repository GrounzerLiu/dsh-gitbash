{
  "name": "dsh-gitbash",
  "version": "0.3.1",
  "description": "DSH profile plugin: run the model-facing bash tool on Git for Windows (Git Bash). NOT file-sandboxed — the msys2 runtime cannot run under the Windows restricted-token sandbox, so commands run with the harness process's full file access (see README).",
  "type": "module",
  "main": "lib/executor.js",
  "exports": {
    ".": "./lib/executor.js",
    "./tool": "./lib/tool.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-jobs": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell-env": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.1",
    "@deepseek-ai/dsh-jobs-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tool-jobs": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    }
  }
}
